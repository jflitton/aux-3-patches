#!/bin/ksh
#
#	dpsetup: set up dp0, the DaynaPORT, for IP. Asks for the address, netmask,
#	gateway and name server (offering what is set now), writes them to
#	/etc/NETADDRS and /etc/resolv.conf and applies them at once; from then on
#	/etc/startup.d/dayna brings dp0 up the same way at every boot.
#
PATH=/bin:/usr/bin:/etc:/usr/etc
NETADDRS=/etc/NETADDRS
RESOLV=/etc/resolv.conf
TMP=/tmp/dpsetup$$

case `id` in
uid=0\(*) ;;
*)	echo "dpsetup: run this as root"; exit 1 ;;
esac
if /etc/ifconfig dp0 > /dev/null 2>&1; then :; else
	echo "dpsetup: this kernel has no dp0 (the DaynaPORT driver is not linked in)"
	exit 1
fi

# split ADDR: its four parts into o1-o4
split() {
	oifs=$IFS; IFS=.
	set -- $1
	IFS=$oifs
	o1=$1 o2=$2 o3=$3 o4=$4
}

# isaddr ADDR: is it a dotted quad?
isaddr() {
	expr "$1" : '[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*$' > /dev/null ||
		return 1
	split $1
	for o in $o1 $o2 $o3 $o4; do
		[ $o -le 255 ] || return 1
	done
	return 0
}

# ask VAR PROMPT DEFAULT: read an address into VAR
ask() {
	while :; do
		if [ -n "$3" ]; then
			echo "$2 [$3]: \c"
		else
			echo "$2: \c"
		fi
		read a
		[ -z "$a" ] && a=$3
		if isaddr "$a"; then
			eval $1=\$a
			return
		fi
		echo "  '$a' is not an address like 192.168.1.50"
	done
}

# what is set now: the dp0 line is "dp0 address broadcast netmask gateway"
set '' `sed -n '/^dp0[ 	]/p' $NETADDRS 2>/dev/null`
shift
cur_ip=$2 cur_mask=$4 cur_gw=$5
cur_dns=`awk '$1 == "nameserver" { print $2; exit }' $RESOLV 2>/dev/null`

while :; do
	ask ip "IP address for dp0" "$cur_ip"
	ask mask "Netmask" "${cur_mask:-255.255.255.0}"
	split $ip
	ask gw "Gateway (your router)" "${cur_gw:-$o1.$o2.$o3.1}"
	ask dns "DNS server" "${cur_dns:-$gw}"

	# broadcast: each part of the address with the host bits set
	bcast=
	split $mask
	m="$o1 $o2 $o3 $o4"
	split $ip
	set -- $o1 $o2 $o3 $o4
	for mo in $m; do
		b=`expr 256 - $mo`
		bcast=$bcast${bcast:+.}`expr $1 / $b \* $b + $b - 1`
		shift
	done

	echo
	echo "  dp0 $ip, netmask $mask (broadcast $bcast)"
	echo "  gateway $gw, DNS server $dns"
	echo "OK? [y] \c"
	read a
	case "$a" in
	""|[yY]*) break ;;
	esac
	cur_ip=$ip cur_mask=$mask cur_gw=$gw cur_dns=$dns
done

# (grep fails when there is no file yet, or nothing to keep)
{ grep -v '^dp0[ 	]' $NETADDRS 2>/dev/null
  echo "dp0	$ip $bcast $mask $gw"; } > $TMP
cp $TMP $NETADDRS
{ echo "nameserver $dns"
  grep -v '^nameserver' $RESOLV 2>/dev/null; } > $TMP
cp $TMP $RESOLV
rm -f $TMP
echo "Wrote $NETADDRS and $RESOLV."

# apply: drop the old default route, then configure as at boot
for g in `netstat -rn | awk '$1 == "default" || $1 == "0.0.0.0" { print $2 }'`; do
	route delete default $g > /dev/null 2>&1
done
/etc/startup.d/dayna

echo "Pinging the gateway:"
/usr/etc/ping $gw 64 2
